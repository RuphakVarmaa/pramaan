# Pramaan — environment template
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env

# Razorpay TEST MODE keys only (Dashboard → Settings → API Keys → Test Mode).
# Keys starting with rzp_live_ are forbidden in this project — test mode only.
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-test-key-secret"

# Optional: force the payment-provider stub (honest fallback when test rails
# are unavailable — surfaced in /health and documented in ENGINEERING_LOG.md)
PRAMAAN_STUB_PAYMENTS=""

# SQLite ledger file (created on demand)
PRAMAAN_DB="data/pramaan.db"

# Optional deterministic seed for the demo Ed25519 signing keypair
PRAMAAN_SIGNING_SEED=""

# Server port
PRAMAAN_PORT="3000"
